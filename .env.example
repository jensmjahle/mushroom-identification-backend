# Rename this file to .env and fill in your own values

# Database connection
DB_URL=jdbc:postgresql://<HOST>:<PORT>/<DB_NAME>
DB_USERNAME=<DB_USERNAME>
DB_PASSWORD=<DB_PASSWORD>

# JWT secret. Used as raw UTF-8 bytes, so it must be at least 32 characters -
# the application refuses to start if it is missing or shorter than that. Generate with:
#   openssl rand -base64 48
SECRET_KEY=<your-256-bit-secret>

# Lookup salt (256-bit salt). Generate with:
#   openssl rand -base64 48
LOOKUP_SALT=<your-256-bit-lookup-salt>

# Comma separated list of origins the browser may call the API from.
# In production this is the public URL of the site.
CORS_ALLOWED_ORIGINS=http://localhost:5173
